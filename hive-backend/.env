# Copia este archivo a ".env" (mismo directorio) y ajusta los valores.
# .env NO debe subirse a git con contraseñas reales.
#
# Valores de ejemplo = configuración estándar de XAMPP (usuario root, sin
# contraseña). Si tu MySQL/MariaDB usa otro usuario o contraseña, cambialos
# acá; no hace falta tocar ningún otro archivo.

DB_HOST=127.0.0.1
DB_NAME=hive_db
DB_USER=root
DB_PASS=gonzalez30

# Ruta base bajo la que Apache sirve este backend, sin barra final.
# Local (XAMPP):  /hive-backend
# Si vive en la raíz del dominio/subdominio: (vacío)
APP_BASE_PATH=/hive-backend
