DB_HOST=127.0.0.1
DB_NAME=hive_db
DB_USER=hive_user
DB_PASS=change-me

# Ruta base bajo la que Apache sirve este backend, sin barra final.
# Local (XAMPP):  /hive-backend
# Hostinger si vive en la raíz del dominio/subdominio: (vacío)
APP_BASE_PATH=/hive-backend

# Ruta absoluta al proyecto RADIODOLIV_PAGINA (sitio público), donde
# site_content.php guarda las imágenes que sube el director desde la app.
# Déjalo vacío para usar el valor por defecto de desarrollo (hermano de
# App-radio bajo htdocs). Defínelo en producción si la ruta es distinta.
RADIODOLIV_PAGINA_PATH=

# SMTP para el envío del OTP de recuperación de contraseña por correo.
# Con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=tu_correo@gmail.com,
# SMTP_PASS=una "contraseña de aplicación" generada en la cuenta de Google
# (no la contraseña normal; requiere verificación en 2 pasos activada).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Radio Doliv
