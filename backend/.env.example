# Copia este archivo a .env y ajusta los valores.

PORT=80
BASE_PATH=/hive-backend

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=team_management

# Cambia esto por un secreto largo y aleatorio en producción.
JWT_SECRET=change-me-please
JWT_EXPIRES_IN=7d

# URL pública con la que se arman los links de imágenes subidas
# (debe coincidir con host:puerto donde corre este servidor).
PUBLIC_URL=http://192.168.100.250
