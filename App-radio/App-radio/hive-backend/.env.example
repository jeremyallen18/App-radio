DB_HOST=127.0.0.1
DB_NAME=hive_db
DB_USER=hive_user
DB_PASS=change-me

# Ruta base bajo la que Apache sirve este backend, sin barra final.
# Local (XAMPP):  /hive-backend
# Hostinger si vive en la raíz del dominio/subdominio: (vacío)
APP_BASE_PATH=/hive-backend

# Origen público del backend (esquema + host + ruta base), SIN barra final.
# Se usa SOLO para los enlaces que se mandan por correo (verificación de
# cuenta), que llevan un token y no deben depender de la cabecera Host.
# Déjalo vacío en local (se detecta del request). En producción, ponlo fijo:
#   PUBLIC_BASE_URL=https://doliv.site/hive-backend
PUBLIC_BASE_URL=

# Llave estática que autoriza a la app interna de Sistemas (proyecto beta_web)
# a editar el contenido del sitio público (endpoints /site/*) SIN login. La
# app la envía en la cabecera X-Api-Key. Genera una con:
#   php -r "echo bin2hex(random_bytes(24)).PHP_EOL;"
# Déjala vacía para deshabilitar esa vía (solo el director por sesión edita).
SITE_CONTENT_KEY=

# Ruta absoluta al proyecto RADIODOLIV_PAGINA (sitio público), donde
# site_content.php guarda las imágenes que sube el director desde la app.
# Déjalo vacío para usar el valor por defecto de desarrollo (hermano de
# App-radio bajo htdocs). Defínelo en producción si la ruta es distinta.
RADIODOLIV_PAGINA_PATH=

# ---------------------------------------------------------------------------
# Referencia para producción (doliv.site) — no se usa en local, es solo la
# plantilla de valores a copiar en el .env real del hosting cuando se migre.
# Layout elegido: hive-backend/ vive como subcarpeta del mismo dominio que
# RADIODOLIV_PAGINA (https://doliv.site/hive-backend), así comparten origen
# y no hace falta configurar CORS.
#
#   DB_HOST=127.0.0.1
#   DB_NAME=hive_db
#   DB_USER=<usuario real que asigne Hostinger>
#   DB_PASS=<password real>
#   APP_BASE_PATH=/hive-backend
#   PUBLIC_BASE_URL=https://doliv.site/hive-backend
#   RADIODOLIV_PAGINA_PATH=/home/<usuario_hostinger>/domains/doliv.site/public_html
#   SMTP_USER=<correo real>
#   SMTP_PASS=<contraseña de aplicación real>
#   SMTP_FROM=<correo real>
#
# RADIODOLIV_PAGINA_PATH real se confirma en el Administrador de archivos o
# por SSH de Hostinger una vez creado el hosting — la ruta de arriba es solo
# el patrón típico de Hostinger, no asumas que es exacta sin verificarla.
# ---------------------------------------------------------------------------

# SMTP para el envío del OTP de recuperación de contraseña por correo.
# Con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=tu_correo@gmail.com,
# SMTP_PASS=una "contraseña de aplicación" generada en la cuenta de Google
# (no la contraseña normal; requiere verificación en 2 pasos activada).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Radio Doliv

# --- Push (Firebase Cloud Messaging) ---
# ID del proyecto Firebase (Configuración del proyecto -> General -> ID del proyecto).
# Déjalo vacío para deshabilitar el push. La clave de cuenta de servicio va en
# hive-backend/private/fcm-service-account.json (no se versiona).
FCM_PROJECT_ID=

# --- Cifrado en reposo de columnas sensibles (crypto.php) ---
# Clave de 32 bytes en base64. Vacía => las columnas se guardan en plano.
# Generar: php -r "echo base64_encode(random_bytes(32));"
# IMPORTANTE: respaldar esta clave POR SEPARADO de la base de datos. Un backup
# que contenga la BD cifrada y este .env juntos anula el cifrado.
DB_ENCRYPTION_KEY=
